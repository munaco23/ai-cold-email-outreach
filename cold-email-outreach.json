            {
              "id": "75cdc193-3d93-404a-8adc-449cf70d0f6d",
              "name": "service_pitch",
              "value": "I'm a freelance AI automation developer. I help small businesses set up AI chatbots for WhatsApp and websites that answer customers 24/7, automatic follow-up with new leads, and automations for repetitive admin work like data entry and appointment reminders, so owners save hours every week.",
