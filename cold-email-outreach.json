      "id": "40f3fbbd-95cb-423a-88fa-f8f3c022b1ed",
      "name": "Read Their Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1408,
        720
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Gets the lead + website text and builds the AI request\nconst lead = $('Loop Over Leads').item.json;\nconst s = $('Settings').first().json;\n\nconst html = typeof $json.data === 'string' ? $json.data : '';\nconst websiteText = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;|&amp;|&#\\d+;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\n\nconst system = `You write short, friendly, human B2B cold emails for ${s.sender_name} from ${s.company_name}.\nWhat we offer: ${s.service_pitch}\nRules:\n- 60 to 110 words, plain text, no links, no emojis, no hype words like \"revolutionize\" or \"game-changer\".\n- Open with one specific observation about THEIR business (from the website text or industry). Never invent facts.\n- Suggest 1 concrete automation idea that fits their business (e.g. auto-replies to inquiries, booking, lead follow-up, invoicing, review requests).\n- End with a soft question like \"Worth a quick 15-minute chat?\"\n- Greet by first name if given, otherwise \"Hi there\".\n- Do NOT add a signature.\nReturn ONLY JSON: {\"subject\": \"...\", \"body\": \"...\"}. Subject: 3-6 words, lowercase-friendly, no clickbait.`;\n\nconst user = `Business name: ${lead.business_name || 'unknown'}\nFirst name: ${lead.first_name || ''}\nIndustry: ${lead.industry || 'unknown'}\nCity: ${lead.city || ''}\nWebsite text: ${websiteText || '(not available)'}`;\n\nreturn {\n  json: {\n    ...lead,\n    requestBody: {\n      model: s.ai_model,\n      temperature: 0.7,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: system },\n        { role: 'user', content: user }\n      ]\n    }\n  }\n};"
      },
      "id": "865e94ff-6a17-40dc-bfbd-e09edf0525f6",
      "name": "Prepare Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        720
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "fef0e81e-7d22-419d-800a-e19f959b6efd",
      "name": "Write Email with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1840,
        720
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns the AI reply into a ready-to-send email\nconst lead = $('Prepare Prompt').item.json;\nconst s = $('Settings').first().json;\n\nlet subject = `quick idea for ${lead.business_name || 'your business'}`;\nlet body = '';\ntry {\n  const c = JSON.parse($json.choices[0].message.content);\n  subject = c.subject || subject;\n  body = c.body || '';\n} catch (e) {}\n\nif (!body) throw new Error('AI did not return an email for ' + lead.email);\n\nconst fullBody = `${body}\n\n${s.sender_name}\n${s.company_name}\n\nP.S. Not relevant? Just reply \"no\" and I won't email again.`;\n\nreturn { json: { email: lead.email, business_name: lead.business_name, subject, body: fullBody } };"
      },
      "id": "028a1058-8090-468c-aee6-c8c4cacf525d",
      "name": "Parse Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2064,
        720
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Settings').first().json.sender_name }} <{{ $('Settings').first().json.sender_email }}>",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {}
      },
      "id": "2d1fc3cd-b1eb-49fa-8d25-9739286b3abf",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
